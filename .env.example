DASHSCOPE_API_KEY=
LLM_MODEL=qwen3.8-max
LLM_SEARCH_MODEL=qwen3.7-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# For a Bailian workspace endpoint, override LLM_BASE_URL locally in .env.
RESPONSES_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# auto: enable web_extractor for DashScope, use web_search only for other compatible gateways.
QWEN_SEARCH_ENABLE_WEB_EXTRACTOR=auto
LLM_TIMEOUT=120
RUNS_DIR=runs

# AI Scientist role models. Fill these with Qwen model IDs available to your account.
AI_SCIENTIST_DIRECTOR_MODEL=
AI_SCIENTIST_RESEARCH_MODEL=
AI_SCIENTIST_METHODOLOGIST_MODEL=
AI_SCIENTIST_HYPOTHESIS_MODEL=
AI_SCIENTIST_DESIGNER_MODEL=
AI_SCIENTIST_ANALYST_MODEL=
AI_SCIENTIST_REPRODUCIBILITY_MODEL=
AI_SCIENTIST_REVIEWER_MODEL=
AI_SCIENTIST_SYNTHESIZER_MODEL=
AI_SCIENTIST_FALLBACK_MODEL=

AI_SCIENTIST_MAX_MODEL_CALLS=50
AI_SCIENTIST_MAX_ITERATIONS=2
AI_SCIENTIST_PROJECTS_DIR=data/research_projects
AI_SCIENTIST_STRUCTURED_RETRY=1
# Complex structured research calls use a separate timeout from ordinary chat.
AI_SCIENTIST_MODEL_TIMEOUT=600
AI_SCIENTIST_DEFAULT_PLANNING_ONLY=true
AI_SCIENTIST_FRONTEND_STEP_TIMEOUT=600
AI_SCIENTIST_SEARCH_TIMEOUT=300
AI_SCIENTIST_SEARCH_QUERY_TIMEOUT=120
AI_SCIENTIST_EXTRACTION_TIMEOUT=300
AI_SCIENTIST_SEARCH_TOTAL_BUDGET=600
AI_SCIENTIST_MAX_SEARCH_QUERIES=4
AI_SCIENTIST_MAX_SEARCH_RESULTS_PER_QUERY=5
AI_SCIENTIST_MAX_EXTRACTED_SOURCES=8
AI_SCIENTIST_MIN_USABLE_SOURCES=3
AI_SCIENTIST_MIN_CURATED_SOURCES=1
AI_SCIENTIST_MIN_VERIFIED_EVIDENCE=1
# Maximum size of one uploaded project reference/data file (default: 25 MiB).
AI_SCIENTIST_MAX_ASSET_BYTES=26214400
# Parse supported uploads immediately. Failed parses preserve the raw file and can be retried from the UI.
AI_SCIENTIST_PARSE_ASSETS_ON_UPLOAD=true
# Bounded parser and model-context limits. Uploaded content is treated as untrusted research material.
AI_SCIENTIST_ASSET_MAX_EXTRACTED_CHARS=50000
AI_SCIENTIST_ASSET_MAX_TABLE_ROWS=500
AI_SCIENTIST_ASSET_SAMPLE_ROWS=10
AI_SCIENTIST_ASSET_MAX_PDF_PAGES=100
AI_SCIENTIST_ASSET_MAX_XML_NODES=5000
AI_SCIENTIST_ASSET_MAX_XLSX_UNCOMPRESSED_BYTES=104857600
AI_SCIENTIST_ASSET_CONTEXT_CHARS=20000
AI_SCIENTIST_ASSET_CONTEXT_PER_FILE_CHARS=6000
# Optional independent model for criterion-level revision verification.
AI_SCIENTIST_REVISION_VERIFIER_MODEL=
# Initial revision plus targeted repairs after verifier feedback (1-3).
AI_SCIENTIST_REVISION_MAX_ATTEMPTS=3
AI_SCIENTIST_SEARCH_ACQUISITION_MODEL=
AI_SCIENTIST_SEARCH_FALLBACK_MODEL=

# Experimental defence-in-depth Python analysis runner. Disabled by default;
# this is not equivalent to a container, VM, or separate OS account.
AI_SCIENTIST_ENABLE_CONTROLLED_PYTHON=0

# Local output root for the deterministic Competition 1B demo and API artifacts.
AI_SCIENTIST_COMPETITION_DIR=competition/1b
# Maximum accepted age of authenticated Qwen smoke evidence (default: 7 days).
AI_SCIENTIST_QWEN_SMOKE_MAX_AGE_HOURS=168
UI_TIMEZONE=Asia/Shanghai

{
  "research_goal": "Find a low-energy gait for a soft swimming robot while preserving acceptable propulsion speed and stability.",
  "constraints": {
    "min_stability": 0.7,
    "max_energy_cost": 1.35,
    "target_metric": "energy_cost",
    "amplitude_range": [
      0.05,
      0.5
    ],
    "frequency_range": [
      0.5,
      3.0
    ],
    "wavelength_range": [
      0.6,
      2.0
    ],
    "stiffness_range": [
      0.1,
      1.0
    ],
    "phase_range": [
      0.0,
      1.0
    ]
  },
  "max_iterations": 3,
  "human_feedback": "Prefer low energy over maximum speed.",
  "random_seed": 7
}